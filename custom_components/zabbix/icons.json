{
  "entity": {
    "binary_sensor": {
      "problem": {
        "default": "mdi:alert-circle",
        "state": { "off": "mdi:check-circle" }
      },
      "maintenance": {
        "default": "mdi:wrench-clock",
        "state": { "off": "mdi:wrench-clock-outline" }
      }
    },
    "event": {
      "problem_events": { "default": "mdi:alert-decagram" }
    },
    "sensor": {
      "problems": { "default": "mdi:alert-circle" },
      "version": { "default": "mdi:information-outline" },
      "hosts": { "default": "mdi:server-network" },
      "items": { "default": "mdi:format-list-checks" },
      "unsupported_items": { "default": "mdi:help-circle-outline" },
      "triggers": { "default": "mdi:flash" },
      "highest_severity": {
        "default": "mdi:alert",
        "state": {
          "none": "mdi:check-circle",
          "not_classified": "mdi:help-circle",
          "information": "mdi:information",
          "warning": "mdi:alert",
          "average": "mdi:alert",
          "high": "mdi:alert-octagon",
          "disaster": "mdi:alert-octagram"
        }
      },
      "availability_agent": {
        "default": "mdi:lan-connect",
        "state": {
          "not_available": "mdi:lan-disconnect",
          "unknown": "mdi:lan-pending",
          "mixed": "mdi:lan-pending"
        }
      },
      "availability_snmp": {
        "default": "mdi:lan-connect",
        "state": {
          "not_available": "mdi:lan-disconnect",
          "unknown": "mdi:lan-pending",
          "mixed": "mdi:lan-pending"
        }
      },
      "availability_ipmi": {
        "default": "mdi:lan-connect",
        "state": {
          "not_available": "mdi:lan-disconnect",
          "unknown": "mdi:lan-pending",
          "mixed": "mdi:lan-pending"
        }
      },
      "availability_jmx": {
        "default": "mdi:lan-connect",
        "state": {
          "not_available": "mdi:lan-disconnect",
          "unknown": "mdi:lan-pending",
          "mixed": "mdi:lan-pending"
        }
      }
    }
  },
  "services": {
    "acknowledge_problem": { "service": "mdi:check" },
    "unacknowledge_problem": { "service": "mdi:undo" },
    "close_problem": { "service": "mdi:close-circle" },
    "start_maintenance": { "service": "mdi:wrench-clock" },
    "end_maintenance": { "service": "mdi:wrench-check" }
  }
}
